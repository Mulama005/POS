{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Supabase": {
    "Url": "https://YOUR-SUPABASE-PROJECT.supabase.co",
    "ServiceRoleKey": "YOUR_SUPABASE_SERVICE_ROLE_KEY",
    "Bucket": "pos-files"
  },

  "Sentry": {
    "Dsn": "YOUR_SENTRY_DSN",
    "Environment": "Development",
    "TracesSampleRate": 0.1
  }
}
